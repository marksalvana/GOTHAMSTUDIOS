    "hero_THJKN8": {
      "type": "hero",
      "blocks": {
        "slide_P4GjB3": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/GSM_LUCA_CHIARAVALLE_profileheadshot-040825_0006.jpg",
            "subheading": "ARTIST FEATURE",
            "title": "Luca Chiaravalle",
            "text": "<p>Melbourne-based artist Luca Chiaravalle creates intricate miniature galleries and contemporary mosaics that explore scale, perception, and the art of looking. His signature Miniature Gallery series places tiny figures within meticulously constructed worlds inside clear acrylic cubes, each piece entirely one-of-a-kind. Intimate in scale yet expansive in feeling, Luca’s work invites you to pause, lean in, and see the world a little differently.</p>",
